<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">

  <variables>
    <variable id="prediction">prediction</variable>
    <variable id="Stake">Stake</variable>
    <variable id="BaseStake">Base Stake</variable>
    <variable id="Martingale">Martingale</variable>
    <variable id="Recovery">Recovery</variable>
  </variables>

  <!-- ============================= -->
  <!-- TRADE DEFINITION               -->
  <!-- ============================= -->

  <block type="trade_definition"
         id="trade_definition_main"
         x="0"
         y="0">

    <statement name="TRADE_OPTIONS">

      <block type="trade_definition_market"
             id="trade_market">

        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ25V</field>

        <next>

          <block type="trade_definition_tradetype"
                 id="trade_type">

            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>

            <next>

              <block type="trade_definition_contracttype"
                     id="contract_type">

                <field name="TYPE_LIST">DIGITOVER</field>

                <next>

                  <block type="trade_definition_candleinterval"
                         id="candle_interval">

                    <field name="CANDLEINTERVAL_LIST">60</field>

                    <next>

                      <block type="trade_definition_restartbuysell"
                             id="restart_buy_sell">

                        <field name="TIME_MACHINE_ENABLED">FALSE</field>

                        <next>

                          <block type="trade_definition_restartonerror"
                                 id="restart_error">

                            <field name="RESTARTONERROR">TRUE</field>

                          </block>

                        </next>

                      </block>

                    </next>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </next>

      </block>

    </statement>


    <!-- ============================= -->
    <!-- INITIALIZATION                 -->
    <!-- ============================= -->

    <statement name="INITIALIZATION">

      <!-- Base Stake = 0.35 -->

      <block type="variables_set"
             id="set_base_stake">

        <field name="VAR" id="BaseStake">Base Stake</field>

        <value name="VALUE">

          <block type="math_number">

            <field name="NUM">0.35</field>

          </block>

        </value>

        <next>

          <!-- Stake = Base Stake -->

          <block type="variables_set"
                 id="set_initial_stake">

            <field name="VAR" id="Stake">Stake</field>

            <value name="VALUE">

              <block type="variables_get">

                <field name="VAR" id="BaseStake">Base Stake</field>

              </block>

            </value>

            <next>

              <!-- Martingale = 2 -->

              <block type="variables_set"
                     id="set_martingale">

                <field name="VAR" id="Martingale">Martingale</field>

                <value name="VALUE">

                  <block type="math_number">

                    <field name="NUM">2</field>

                  </block>

                </value>

                <next>

                  <!-- Recovery = 0 -->

                  <block type="variables_set"
                         id="set_recovery">

                    <field name="VAR" id="Recovery">Recovery</field>

                    <value name="VALUE">

                      <block type="math_number">

                        <field name="NUM">0</field>

                      </block>

                    </value>

                    <next>

                      <!-- Prediction = 6 -->

                      <block type="variables_set"
                             id="set_prediction">

                        <field name="VAR" id="prediction">prediction</field>

                        <value name="VALUE">

                          <block type="math_number">

                            <field name="NUM">6</field>

                          </block>

                        </value>

                      </block>

                    </next>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </next>

      </block>

    </statement>


    <!-- ============================= -->
    <!-- TRADE OPTIONS                  -->
    <!-- ============================= -->

    <statement name="SUBMARKET">

      <block type="trade_definition_tradeoptions"
             id="trade_options">

        <mutation
          xmlns="http://www.w3.org/1999/xhtml"
          has_first_barrier="false"
          has_second_barrier="false"
          has_prediction="true">
        </mutation>

        <field name="DURATIONTYPE_LIST">t</field>

        <value name="DURATION">

          <shadow type="math_number_positive">

            <field name="NUM">1</field>

          </shadow>

        </value>

        <value name="AMOUNT">

          <shadow type="math_number_positive">

            <field name="NUM">0.35</field>

          </shadow>

          <block type="variables_get">

            <field name="VAR" id="Stake">Stake</field>

          </block>

        </value>

        <value name="PREDICTION">

          <shadow type="math_number_positive">

            <field name="NUM">6</field>

          </shadow>

          <block type="variables_get">

            <field name="VAR" id="prediction">prediction</field>

          </block>

        </value>

      </block>

    </statement>

  </block>


  <!-- ================================= -->
  <!-- BEFORE PURCHASE                    -->
  <!-- ================================= -->

  <block type="before_purchase"
         id="before_purchase_main"
         x="0"
         y="800">

    <statement name="BEFOREPURCHASE_STACK">

      <!-- =============================== -->
      <!-- NORMAL TRADE                     -->
      <!-- prediction = 6                   -->
      <!-- BUY OVER 6                       -->
      <!-- =============================== -->

      <block type="controls_if"
             id="select_trade_mode">

        <mutation
          xmlns="http://www.w3.org/1999/xhtml"
          else="1">
        </mutation>

        <value name="IF0">

          <block type="logic_compare"
                 id="check_normal">

            <field name="OP">EQ</field>

            <value name="A">

              <block type="variables_get">

                <field name="VAR" id="Recovery">Recovery</field>

              </block>

            </value>

            <value name="B">

              <block type="math_number">

                <field name="NUM">0</field>

              </block>

            </value>

          </block>

        </value>

        <statement name="DO0">

          <block type="variables_set"
                 id="normal_prediction">

            <field name="VAR" id="prediction">prediction</field>

            <value name="VALUE">

              <block type="math_number">

                <field name="NUM">6</field>

              </block>

            </value>

            <next>

              <block type="purchase"
                     id="buy_over_6">

                <field name="PURCHASE_LIST">DIGITOVER</field>

              </block>

            </next>

          </block>

        </statement>


        <!-- =============================== -->
        <!-- RECOVERY TRADE                   -->
        <!-- prediction = 3                   -->
        <!-- BUY OVER 3                       -->
        <!-- =============================== -->

        <statement name="ELSE">

          <block type="variables_set"
                 id="recovery_prediction">

            <field name="VAR" id="prediction">prediction</field>

            <value name="VALUE">

              <block type="math_number">

                <field name="NUM">3</field>

              </block>

            </value>

            <next>

              <block type="purchase"
                     id="buy_over_3">

                <field name="PURCHASE_LIST">DIGITOVER</field>

              </block>

            </next>

          </block>

        </statement>

      </block>

    </statement>

  </block>


  <!-- ================================= -->
  <!-- AFTER PURCHASE                    -->
  <!-- ================================= -->

  <block type="after_purchase"
         id="after_purchase_main"
         x="700"
         y="0">

    <statement name="AFTERPURCHASE_STACK">

      <block type="controls_if"
             id="result_handler">

        <mutation
          xmlns="http://www.w3.org/1999/xhtml"
          elseif="1">
        </mutation>


        <!-- =============================== -->
        <!-- WIN                              -->
        <!-- =============================== -->

        <value name="IF0">

          <block type="contract_check_result"
                 id="check_win">

            <field name="CHECK_RESULT">win</field>

          </block>

        </value>

        <statement name="DO0">

          <!-- Stake = Base Stake -->

          <block type="variables_set"
                 id="win_reset_stake">

            <field name="VAR" id="Stake">Stake</field>

            <value name="VALUE">

              <block type="variables_get">

                <field name="VAR" id="BaseStake">Base Stake</field>

              </block>

            </value>

            <next>

              <!-- Recovery = 0 -->

              <block type="variables_set"
                     id="win_reset_recovery">

                <field name="VAR" id="Recovery">Recovery</field>

                <value name="VALUE">

                  <block type="math_number">

                    <field name="NUM">0</field>

                  </block>

                </value>

                <next>

                  <!-- Prediction = 6 -->

                  <block type="variables_set"
                         id="win_prediction">

                    <field name="VAR" id="prediction">prediction</field>

                    <value name="VALUE">

                      <block type="math_number">

                        <field name="NUM">6</field>

                      </block>

                    </value>

                    <next>

                      <!-- BUY AGAIN -->

                      <block type="trade_again"
                             id="trade_again_win">
                      </block>

                    </next>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </statement>


        <!-- =============================== -->
        <!-- LOSS                             -->
        <!-- =============================== -->

        <value name="IF1">

          <block type="contract_check_result"
                 id="check_loss">

            <field name="CHECK_RESULT">loss</field>

          </block>

        </value>

        <statement name="DO1">

          <!-- Stake = Stake × 2 -->

          <block type="variables_set"
                 id="loss_martingale">

            <field name="VAR" id="Stake">Stake</field>

            <value name="VALUE">

              <block type="math_arithmetic">

                <field name="OP">MULTIPLY</field>

                <value name="A">

                  <block type="variables_get">

                    <field name="VAR" id="Stake">Stake</field>

                  </block>

                </value>

                <value name="B">

                  <block type="variables_get">

                    <field name="VAR" id="Martingale">Martingale</field>

                  </block>

                </value>

              </block>

            </value>

            <next>

              <!-- Recovery = 1 -->

              <block type="variables_set"
                     id="enable_recovery">

                <field name="VAR" id="Recovery">Recovery</field>

                <value name="VALUE">

                  <block type="math_number">

                    <field name="NUM">1</field>

                  </block>

                </value>

                <next>

                  <!-- Prediction = 3 -->

                  <block type="variables_set"
                         id="loss_prediction">

                    <field name="VAR" id="prediction">prediction</field>

                    <value name="VALUE">

                      <block type="math_number">

                        <field name="NUM">3</field>

                      </block>

                    </value>

                    <next>

                      <!-- BUY OVER 3 -->

                      <block type="trade_again"
                             id="trade_again_recovery">
                      </block>

                    </next>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </statement>

      </block>

    </statement>

  </block>

</xml>