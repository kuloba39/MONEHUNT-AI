<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="o2_least_digit_id">leastDigit</variable>
    <variable id="o2_stake_id">Stake</variable>
    <variable id="o2_initial_stake_id">InitialStake</variable>
    <variable id="o2_tp_id">TakeProfit</variable>
    <variable id="o2_mart_level_id">MartingaleLevel</variable>
    <variable id="o2_mart_id">Martingale</variable>
    <variable id="o2_loss_cnt_id">lossCounter</variable>
    <variable id="o2_tm_id">trading mode</variable>
    <variable id="o2_ld_id">last digit</variable>
    <variable id="o2_armed_id">entry armed</variable>
    <variable id="o2_text_id">text</variable>
    <variable id="o2_stop_loss_id">StopLoss</variable>
  </variables>

  <block type="trade_definition" id="o2_trade_def" deletable="false" x="0" y="60">
    <statement name="TRADE_OPTIONS">

      <block type="trade_definition_market" id="o2_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ75V</field>

        <next>
          <block type="trade_definition_tradetype" id="o2_tradetype" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>

            <next>
              <block type="trade_definition_contracttype" id="o2_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>

                <next>
                  <block type="trade_definition_candleinterval" id="o2_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>

                    <next>
                      <block type="trade_definition_restartbuysell" id="o2_restart" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>

                        <next>
                          <block type="trade_definition_restartonerror" id="o2_restart_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>

                      </block>
                    </next>

                  </block>
                </next>

              </block>
            </next>

          </block>
        </next>

      </block>
    </statement>

    <statement name="INITIALIZATION">

      <block type="notify" id="o2_init_notify">
        <field name="NOTIFICATION_TYPE">success</field>
        <field name="NOTIFICATION_SOUND">silent</field>

        <value name="MESSAGE">
          <shadow type="text" id="o2_init_msg">
            <field name="TEXT">OVER 2 BOT READY</field>
          </shadow>
        </value>

        <next>

          <block type="variables_set" id="o2_least_digit_init">
            <field name="VAR" id="o2_least_digit_id">leastDigit</field>

            <value name="VALUE">
              <block type="math_number" id="o2_least_digit_num">
                <field name="NUM">1</field>
              </block>
            </value>

            <next>

              <block type="variables_set" id="o2_stake_init">
                <field name="VAR" id="o2_stake_id">Stake</field>

                <value name="VALUE">
                  <block type="math_number" id="o2_stake_num">
                    <field name="NUM">10</field>
                  </block>
                </value>

                <next>

                  <block type="variables_set" id="o2_initial_stake_init">
                    <field name="VAR" id="o2_initial_stake_id">InitialStake</field>

                    <value name="VALUE">
                      <block type="math_number" id="o2_initial_stake_num">
                        <field name="NUM">10</field>
                      </block>
                    </value>

                    <next>

                      <block type="variables_set" id="o2_tp_init">
                        <field name="VAR" id="o2_tp_id">TakeProfit</field>

                        <value name="VALUE">
                          <block type="math_number" id="o2_tp_num">
                            <field name="NUM">15</field>
                          </block>
                        </value>

                        <next>

                          <block type="variables_set" id="o2_mart_level_init">
                            <field name="VAR" id="o2_mart_level_id">MartingaleLevel</field>

                            <value name="VALUE">
                              <block type="math_number" id="o2_mart_level_num">
                                <field name="NUM">6</field>
                              </block>
                            </value>

                            <next>

                              <block type="variables_set" id="o2_mart_init">
                                <field name="VAR" id="o2_mart_id">Martingale</field>

                                <value name="VALUE">
                                  <block type="math_number" id="o2_mart_num">
                                    <field name="NUM">2</field>
                                  </block>
                                </value>

                                <next>

                                  <block type="variables_set" id="o2_loss_init">
                                    <field name="VAR" id="o2_loss_cnt_id">lossCounter</field>

                                    <value name="VALUE">
                                      <block type="math_number" id="o2_loss_num">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>

                                    <next>

                                      <block type="variables_set" id="o2_tm_init">
                                        <field name="VAR" id="o2_tm_id">trading mode</field>

                                        <value name="VALUE">
                                          <block type="math_number" id="o2_tm_zero">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>

                                        <next>

                                          <block type="variables_set" id="o2_armed_init">
                                            <field name="VAR" id="o2_armed_id">entry armed</field>

                                            <value name="VALUE">
                                              <block type="math_number" id="o2_armed_zero">
                                                <field name="NUM">0</field>
                                              </block>
                                            </value>

                                            <next>

                                              <block type="variables_set" id="o2_stop_loss_init">
                                                <field name="VAR" id="o2_stop_loss_id">StopLoss</field>

                                                <value name="VALUE">
                                                  <block type="math_number" id="o2_stop_loss_num">
                                                    <field name="NUM">50</field>
                                                  </block>
                                                </value>

                                              </block>

                                            </next>

                                          </block>

                                        </next>

                                      </block>

                                    </next>

                                  </block>

                                </next>

                              </block>

                            </next>

                          </block>

                        </next>

                      </block>

                    </next>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </next>

      </block>

    </statement>

    <statement name="SUBMARKET">

      <block type="trade_definition_tradeoptions" id="o2_trade_options">

        <mutation xmlns="http://www.w3.org/1999/xhtml"
          has_first_barrier="false"
          has_second_barrier="false"
          has_prediction="true">
        </mutation>

        <field name="DURATIONTYPE_LIST">t</field>

        <value name="DURATION">

          <shadow type="math_number_positive" id="o2_duration">
            <field name="NUM">1</field>
          </shadow>

        </value>

        <value name="AMOUNT">

          <shadow type="math_number_positive" id="o2_amount_shadow">
            <field name="NUM">0.35</field>
          </shadow>

          <block type="variables_get" id="o2_stake_get">
            <field name="VAR" id="o2_stake_id">Stake</field>
          </block>

        </value>

        <value name="PREDICTION">

          <shadow type="math_number_positive" id="o2_prediction_shadow" inline="true">
            <field name="NUM">2</field>
          </shadow>

        </value>

      </block>

    </statement>

  </block>

  <block type="after_purchase" id="o2_after_purchase" x="900" y="60">

    <statement name="AFTERPURCHASE_STACK">

      <block type="controls_if" id="o2_tp_check">

        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

        <value name="IF0">

          <block type="logic_compare" id="o2_tp_compare">

            <field name="OP">GTE</field>

            <value name="A">
              <block type="total_profit" id="o2_tp_profit"></block>
            </value>

            <value name="B">
              <block type="variables_get" id="o2_tp_value">
                <field name="VAR" id="o2_tp_id">TakeProfit</field>
              </block>
            </value>

          </block>

        </value>

        <statement name="DO0">

          <block type="variables_set" id="o2_tp_mode_off">

            <field name="VAR" id="o2_tm_id">trading mode</field>

            <value name="VALUE">
              <block type="math_number" id="o2_tp_mode_zero">
                <field name="NUM">0</field>
              </block>
            </value>

            <next>

              <block type="variables_set" id="o2_tp_arm_off">

                <field name="VAR" id="o2_armed_id">entry armed</field>

                <value name="VALUE">
                  <block type="math_number" id="o2_tp_arm_zero">
                    <field name="NUM">0</field>
                  </block>
                </value>

                <next>

                  <block type="notify" id="o2_tp_notify">

                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">earned-money</field>

                    <value name="MESSAGE">

                      <shadow type="text" id="o2_tp_text">
                        <field name="TEXT">OVER 2 Take Profit reached</field>
                      </shadow>

                    </value>

                  </block>

                </next>

              </block>

            </next>

          </block>

        </statement>

        <statement name="ELSE">

          <block type="controls_if" id="o2_result_check">

            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

            <value name="IF0">

              <block type="contract_check_result" id="o2_win_check">
                <field name="CHECK_RESULT">win</field>
              </block>

            </value>

            <statement name="DO0">

              <block type="variables_set" id="o2_win_stake">

                <field name="VAR" id="o2_stake_id">Stake</field>

                <value name="VALUE">

                  <block type="variables_get" id="o2_win_stake_value">
                    <field name="VAR" id="o2_initial_stake_id">InitialStake</field>
                  </block>

                </value>

                <next>

                  <block type="variables_set" id="o2_win_loss_reset">

                    <field name="VAR" id="o2_loss_cnt_id">lossCounter</field>

                    <value name="VALUE">

                      <block type="math_number" id="o2_win_loss_zero">
                        <field name="NUM">0</field>
                      </block>

                    </value>

                    <next>

                      <block type="trade_again" id="o2_win_trade_again"></block>

                    </next>

                  </block>

                </next>

              </block>

            </statement>

            <statement name="ELSE">

              <block type="variables_set" id="o2_loss_stake">

                <field name="VAR" id="o2_stake_id">Stake</field>

                <value name="VALUE">

                  <block type="math_arithmetic" id="o2_loss_multiply">

                    <field name="OP">MULTIPLY</field>

                    <value name="A">

                      <block type="variables_get" id="o2_loss_current_stake">
                        <field name="VAR" id="o2_stake_id">Stake</field>
                      </block>

                    </value>

                    <value name="B">

                      <block type="variables_get" id="o2_loss_mart">
                        <field name="VAR" id="o2_mart_id">Martingale</field>
                      </block>

                    </value>

                  </block>

                </value>

                <next>

                  <block type="math_change" id="o2_loss_counter">

                    <field name="VAR" id="o2_loss_cnt_id">lossCounter</field>

                    <value name="DELTA">

                      <shadow type="math_number" id="o2_loss_delta">
                        <field name="NUM">1</field>
                      </shadow>

                    </value>

                  </block>

                </next>

              </block>

            </statement>

            <next>

              <block type="controls_if" id="o2_sl_check">

                <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

                <value name="IF0">

                  <block type="logic_compare" id="o2_sl_compare">

                    <field name="OP">LTE</field>

                    <value name="A">
                      <block type="total_profit" id="o2_sl_profit"></block>
                    </value>

                    <value name="B">

                      <block type="math_single" id="o2_sl_negative">

                        <field name="OP">NEG</field>

                        <value name="NUM">

                          <block type="variables_get" id="o2_sl_value">
                            <field name="VAR" id="o2_stop_loss_id">StopLoss</field>
                          </block>

                        </value>

                      </block>

                    </value>

                  </block>

                </value>

                <statement name="DO0">

                  <block type="variables_set" id="o2_sl_mode">

                    <field name="VAR" id="o2_tm_id">trading mode</field>

                    <value name="VALUE">

                      <block type="math_number" id="o2_sl_mode_zero">
                        <field name="NUM">0</field>
                      </block>

                    </value>

                    <next>

                      <block type="variables_set" id="o2_sl_arm_off">

                        <field name="VAR" id="o2_armed_id">entry armed</field>

                        <value name="VALUE">

                          <block type="math_number" id="o2_sl_arm_zero">
                            <field name="NUM">0</field>
                          </block>

                        </value>

                        <next>

                          <block type="notify" id="o2_sl_notify">

                            <field name="NOTIFICATION_TYPE">error</field>
                            <field name="NOTIFICATION_SOUND">error</field>

                            <value name="MESSAGE">

                              <shadow type="text" id="o2_sl_message">
                                <field name="TEXT">OVER 2 Stop Loss reached</field>
                              </shadow>

                            </value>

                          </block>

                        </next>

                      </block>

                    </next>

                  </block>

                </statement>

                <statement name="ELSE">

                  <block type="controls_if" id="o2_mart_check">

                    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

                    <value name="IF0">

                      <block type="logic_compare" id="o2_mart_compare">

                        <field name="OP">LTE</field>

                        <value name="A">

                          <block type="variables_get" id="o2_loss_count_get">
                            <field name="VAR" id="o2_loss_cnt_id">lossCounter</field>
                          </block>

                        </value>

                        <value name="B">

                          <block type="variables_get" id="o2_mart_level_get">
                            <field name="VAR" id="o2_mart_level_id">MartingaleLevel</field>
                          </block>

                        </value>

                      </block>

                    </value>

                    <statement name="DO0">

                      <block type="trade_again" id="o2_loss_trade_again"></block>

                    </statement>

                    <statement name="ELSE">

                      <block type="variables_set" id="o2_mart_stop_mode">

                        <field name="VAR" id="o2_tm_id">trading mode</field>

                        <value name="VALUE">

                          <block type="math_number" id="o2_mart_stop_zero">
                            <field name="NUM">0</field>
                          </block>

                        </value>

                        <next>

                          <block type="variables_set" id="o2_mart_stop_arm">

                            <field name="VAR" id="o2_armed_id">entry armed</field>

                            <value name="VALUE">

                              <block type="math_number" id="o2_mart_stop_arm_zero">
                                <field name="NUM">0</field>
                              </block>

                            </value>

                          </block>

                        </next>

                      </block>

                    </statement>

                  </block>

                </statement>

              </block>

            </next>

          </block>

        </statement>

      </block>

    </statement>

  </block>

  <block type="before_purchase" id="o2_before_purchase" deletable="false" x="0" y="976">

    <statement name="BEFOREPURCHASE_STACK">

      <block type="controls_if" id="o2_continuous_gate">

        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

        <value name="IF0">

          <block type="logic_compare" id="o2_continuous_compare">

            <field name="OP">EQ</field>

            <value name="A">

              <block type="variables_get" id="o2_continuous_mode">
                <field name="VAR" id="o2_tm_id">trading mode</field>
              </block>

            </value>

            <value name="B">

              <block type="math_number" id="o2_continuous_one">
                <field name="NUM">1</field>
              </block>

            </value>

          </block>

        </value>

        <statement name="DO0">

          <block type="purchase" id="o2_continuous_purchase">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>

        </statement>

        <statement name="ELSE">

          <block type="controls_if" id="o2_armed_gate">

            <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

            <value name="IF0">

              <block type="logic_compare" id="o2_armed_compare">

                <field name="OP">EQ</field>

                <value name="A">

                  <block type="variables_get" id="o2_armed_get">
                    <field name="VAR" id="o2_armed_id">entry armed</field>
                  </block>

                </value>

                <value name="B">

                  <block type="math_number" id="o2_armed_one">
                    <field name="NUM">1</field>
                  </block>

                </value>

              </block>

            </value>

            <statement name="DO0">

              <block type="variables_set" id="o2_next_digit">

                <field name="VAR" id="o2_ld_id">last digit</field>

                <value name="VALUE">
                  <block type="last_digit" id="o2_next_last_digit"></block>
                </value>

                <next>

                  <block type="controls_if" id="o2_range_check">

                    <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>

                    <value name="IF0">

                      <block type="logic_operation" id="o2_range_3_8">

                        <field name="OP">AND</field>

                        <value name="A">

                          <block type="logic_compare" id="o2_ge_3">

                            <field name="OP">GTE</field>

                            <value name="A">

                              <block type="variables_get" id="o2_next_digit_get">
                                <field name="VAR" id="o2_ld_id">last digit</field>
                              </block>

                            </value>

                            <value name="B">

                              <block type="math_number" id="o2_three">
                                <field name="NUM">3</field>
                              </block>

                            </value>

                          </block>

                        </value>

                        <value name="B">

                          <block type="logic_compare" id="o2_le_8">

                            <field name="OP">LTE</field>

                            <value name="A">

                              <block type="variables_get" id="o2_next_digit_get2">
                                <field name="VAR" id="o2_ld_id">last digit</field>
                              </block>

                            </value>

                            <value name="B">

                              <block type="math_number" id="o2_eight">
                                <field name="NUM">8</field>
                              </block>

                            </value>

                          </block>

                        </value>

                      </block>

                    </value>

                    <statement name="DO0">

                      <block type="variables_set" id="o2_activate_continuous">

                        <field name="VAR" id="o2_tm_id">trading mode</field>

                        <value name="VALUE">

                          <block type="math_number" id="o2_mode_one">
                            <field name="NUM">1</field>
                          </block>

                        </value>

                        <next>

                          <block type="variables_set" id="o2_disarm">

                            <field name="VAR" id="o2_armed_id">entry armed</field>

                            <value name="VALUE">

                              <block type="math_number" id="o2_disarm_zero">
                                <field name="NUM">0</field>
                              </block>

                            </value>

                            <next>

                              <block type="purchase" id="o2_first_purchase">

                                <field name="PURCHASE_LIST">DIGITOVER</field>

                              </block>

                            </next>

                          </block>

                        </next>

                      </block>

                    </statement>

                    <statement name="ELSE">

                      <block type="variables_set" id="o2_rearm_wait">

                        <field name="VAR" id="o2_armed_id">entry armed</field>

                        <value name="VALUE">

                          <block type="math_number" id="o2_rearm_zero">
                            <field name="NUM">0</field>
                          </block>

                        </value>

                      </block>

                    </statement>

                  </block>

                </next>

              </block>

            </statement>

            <statement name="ELSE">

              <block type="variables_set" id="o2_scan_digit">

                <field name="VAR" id="o2_ld_id">last digit</field>

                <value name="VALUE">
                  <block type="last_digit" id="o2_scan_last_digit"></block>
                </value>

                <next>

                  <block type="controls_if" id="o2_least_gate">

                    <value name="IF0">

                      <block type="logic_compare" id="o2_least_compare">

                        <field name="OP">EQ</field>

                        <value name="A">

                          <block type="variables_get" id="o2_scan_digit_get">
                            <field name="VAR" id="o2_ld_id">last digit</field>
                          </block>

                        </value>

                        <value name="B">

                          <block type="variables_get" id="o2_least_digit_get">
                            <field name="VAR" id="o2_least_digit_id">leastDigit</field>
                          </block>

                        </value>

                      </block>

                    </value>

                    <statement name="DO0">

                      <block type="variables_set" id="o2_arm_entry">

                        <field name="VAR" id="o2_armed_id">entry armed</field>

                        <value name="VALUE">

                          <block type="math_number" id="o2_arm_one">
                            <field name="NUM">1</field>
                          </block>

                        </value>

                      </block>

                    </statement>

                  </block>

                </next>

              </block>

            </statement>

          </block>

        </statement>

      </block>

    </statement>

  </block>

</xml>